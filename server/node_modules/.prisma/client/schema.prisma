// RecruitmentX Prisma Database Schema
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. USER MODEL
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         String   @default("CANDIDATE") // CANDIDATE | RECRUITER | ADMIN
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile         Profile?
  resumes         Resume[]
  gitHubProfile   GitHubProfile?
  jobDescriptions JobDescription[]  @relation("RecruiterJobs")
  jobMatches      JobMatch[]        @relation("CandidateJobMatches")
  recommendations Recommendations[]
}

// 2. PROFILE MODEL
model Profile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio          String?
  headline     String?
  phone        String?
  location     String?
  websiteUrl   String?
  linkedinUrl  String?
  githubUrl    String?
  desiredRole  String?
  targetSalary String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  skills         Skills[]
  projects       Projects[]
  certifications Certifications[]
  experiences    Experience[]
  educations     Education[]
}

// 3. RESUME MODEL
model Resume {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  summary    String?
  fileUrl    String?
  fileName   String?
  rawText    String?
  templateId String   @default("modern")
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  analyses       ResumeAnalysis[]
  jobMatches     JobMatch[]
  experiences    Experience[]
  educations     Education[]
  projects       Projects[]
  skills         Skills[]
  certifications Certifications[]
}

// 4. RESUME ANALYSIS MODEL (ATS Scoring)
model ResumeAnalysis {
  id                     String          @id @default(uuid())
  resumeId               String
  resume                 Resume          @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobDescriptionId       String?
  jobDescription         JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  overallAtsScore        Int
  keywordMatchScore      Int
  formattingScore        Int
  impactScore            Int
  matchedKeywords        String[]
  missingKeywords        String[]
  weakBullets            String[]
  strengths              String[]
  improvementSuggestions String[]
  rawAiOutput            String?
  createdAt              DateTime        @default(now())
}

// 5. SKILLS MODEL
model Skills {
  id                String   @id @default(uuid())
  profileId         String?
  profile           Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  resumeId          String?
  resume            Resume?  @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  name              String
  category          String   @default("Technical")
  proficiency       String   @default("Intermediate")
  yearsOfExperience Float?
  createdAt         DateTime @default(now())
}

// 6. PROJECTS MODEL
model Projects {
  id            String   @id @default(uuid())
  profileId     String?
  profile       Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  resumeId      String?
  resume        Resume?  @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  title         String
  description   String
  techStack     String[]
  githubRepoUrl String?
  liveDemoUrl   String?
  highlights    String[]
  createdAt     DateTime @default(now())
}

// 7. CERTIFICATIONS MODEL
model Certifications {
  id                  String    @id @default(uuid())
  profileId           String?
  profile             Profile?  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  resumeId            String?
  resume              Resume?   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  name                String
  issuingOrganization String
  issueDate           DateTime?
  expiryDate          DateTime?
  credentialId        String?
  credentialUrl       String?
  createdAt           DateTime  @default(now())
}

// 8. EXPERIENCE MODEL
model Experience {
  id           String   @id @default(uuid())
  profileId    String?
  profile      Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  resumeId     String?
  resume       Resume?  @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  company      String
  position     String
  location     String?
  startDate    String
  endDate      String?
  isCurrent    Boolean  @default(false)
  description  String?
  bulletPoints String[]
  technologies String[]
  createdAt    DateTime @default(now())
}

// 9. EDUCATION MODEL
model Education {
  id           String   @id @default(uuid())
  profileId    String?
  profile      Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  resumeId     String?
  resume       Resume?  @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  institution  String
  degree       String
  fieldOfStudy String
  startDate    String?
  endDate      String?
  gpa          String?
  honors       String?
  createdAt    DateTime @default(now())
}

// 10. GITHUB PROFILE MODEL
model GitHubProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username           String
  publicReposCount   Int      @default(0)
  totalStars         Int      @default(0)
  totalForks         Int      @default(0)
  topLanguages       String[]
  technicalScore     Int      @default(0)
  summaryText        String?
  recentRepositories String?
  lastAuditedAt      DateTime @default(now())
}

// 11. JOB DESCRIPTION MODEL
model JobDescription {
  id                 String   @id @default(uuid())
  recruiterId        String?
  recruiter          User?    @relation("RecruiterJobs", fields: [recruiterId], references: [id], onDelete: SetNull)
  title              String
  company            String
  department         String?
  location           String
  employmentType     String   @default("FULL_TIME")
  salaryRange        String?
  description        String
  requiredSkills     String[]
  preferredSkills    String[]
  minExperienceYears Int      @default(0)
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  analyses        ResumeAnalysis[]
  jobMatches      JobMatch[]
  recommendations Recommendations[]
}

// 12. JOB MATCH MODEL
model JobMatch {
  id                        String         @id @default(uuid())
  jobDescriptionId          String
  jobDescription            JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  candidateId               String
  candidate                 User           @relation("CandidateJobMatches", fields: [candidateId], references: [id], onDelete: Cascade)
  resumeId                  String?
  resume                    Resume?        @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  matchPercentage           Float
  skillsMatchPercentage     Float
  experienceMatchPercentage Float
  status                    String         @default("MATCHED")
  fitSummary                String?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
}

// 13. RECOMMENDATIONS MODEL
model Recommendations {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobDescriptionId String?
  jobDescription   JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  type             String
  title            String
  content          String
  actionItems      String[]
  createdAt        DateTime        @default(now())
}
